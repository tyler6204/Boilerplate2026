{
  "name": "boilerplate-2026",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev:all": "concurrently --names \"website,convex,mobile\" --prefix-colors \"cyan,magenta,green\" \"pnpm dev:website-only\" \"pnpm dev:convex\" \"pnpm dev:mobile-only\"",
    "dev:website": "concurrently --names \"website,convex\" --prefix-colors \"cyan,magenta\" \"pnpm dev:website-only\" \"pnpm dev:convex\"",
    "dev:website-only": "pnpm --filter @boilerplate/website dev",
    "dev:mobile:ios": "concurrently --names \"mobile,convex\" --prefix-colors \"green,magenta\" \"pnpm dev:mobile-only:ios\" \"pnpm dev:convex\"",
    "dev:mobile:android": "concurrently --names \"mobile,convex\" --prefix-colors \"green,magenta\" \"pnpm dev:mobile-only:android\" \"pnpm dev:convex\"",
    "dev:mobile-only:ios": "pnpm --filter @boilerplate/mobile dev:ios",
    "dev:mobile-only:android": "pnpm --filter @boilerplate/mobile dev:android",
    "dev:convex": "pnpm exec convex dev",
    "build": "pnpm --filter @boilerplate/website build"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@tailwindcss/oxide"
    ],
    "overrides": {
      "lightningcss": "1.30.1"
    }
  },
  "dependencies": {
    "convex": "^1.31.2",
    "concurrently": "^9.2.1"
  }
}