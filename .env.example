# ===========================================
# Boilerplate 2026 - Environment Variables
# ===========================================
# Copy this file to .env.local and update with your actual values

# ===========================================
# APP INFO
# ===========================================
# Web (NEXT_PUBLIC_ prefix for browser access)
NEXT_PUBLIC_APP_NAME=Boilerplate 2026
NEXT_PUBLIC_VERSION=1.0.0
NEXT_PUBLIC_CONTACT_EMAIL=contact@example.com

# Mobile (EXPO_PUBLIC_ prefix for app access)
EXPO_PUBLIC_APP_NAME=Boilerplate 2026
EXPO_PUBLIC_VERSION=1.0.0

# ===========================================
# URLS
# ===========================================
NEXT_PUBLIC_SITE_URL=http://lvh.me:3000
NEXT_PUBLIC_API_URL=http://api.lvh.me:3000

# Mobile App Store Links
NEXT_PUBLIC_IOS_APP_URL=https://apps.apple.com/us/app/example
NEXT_PUBLIC_ANDROID_APP_URL=https://play.google.com/store/apps/details?id=com.example

# ===========================================
# CONVEX (Backend)
# ===========================================
CONVEX_DEPLOYMENT=YOUR_CONVEX_DEPLOYMENT
NEXT_PUBLIC_CONVEX_URL=https://YOUR_CONVEX_URL.convex.cloud
EXPO_PUBLIC_CONVEX_URL=https://YOUR_CONVEX_URL.convex.cloud

# ===========================================
# ANALYTICS (PostHog)
# ===========================================
NEXT_PUBLIC_POSTHOG_KEY=YOUR_API_KEY
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ===========================================
# PAYMENTS (Stripe) - Web only
# ===========================================
# STRIPE_SECRET_KEY=sk_test_xxx
# STRIPE_WEBHOOK_SECRET=whsec_xxx
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
